{
  "name": "house-of-briar",
  "version": "1.0.0",
  "private": true,
  "description": "House of Briar storefront with designer uploads and a public gallery",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "backup": "node scripts/backup-data.js",
    "verify:backup": "node scripts/verify-backup.js",
    "test:e2e": "playwright test",
    "e2e:serve": "npm --prefix apps/default run build && node scripts/e2e-server.js",
    "backup:offsite": "node scripts/backup-offsite.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^18.0.4",
    "express": "^5.1.0",
    "geoip-lite": "1.4.10",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  },
  "overrides": {
    "geoip-lite": {
      "ip-address": "10.7.4"
    }
  }
}
