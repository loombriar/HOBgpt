PORT=3000
DATA_DIR=.data
DESIGNER_TOKENS_JSON={"replace-with-long-random-designer-token":"designer-1"}
ADMIN_TOKEN=replace-with-a-different-long-random-admin-token
REVIEW_REQUIRED=true

# Stripe server secret. Never expose this value to browser code.
STRIPE_SECRET_KEY=sk_test_replace_me
# JSON map of House of Briar designer IDs to Stripe Connect account IDs.
STRIPE_CONNECT_ACCOUNTS_JSON={"designer-1":"acct_replace_me"}
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# EasyPost server key used to verify designer shipment tracking before payout.
EASYPOST_API_KEY=EZAK_replace_me
EASYPOST_WEBHOOK_SECRET=replace_with_long_random_webhook_secret

# Resend transactional email. Verify the sending domain before production.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=House of Briar <orders@replace-with-verified-domain.example>
