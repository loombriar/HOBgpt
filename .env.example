APP_ORIGIN=https://your-house-of-briar-domain.example
# Required for trusted outbound OIDC discovery in any externally reachable environment.
# Without APP_ORIGIN, external OIDC bearer login is disabled (production startup fails).
# Use the actual trusted public origin; never infer the identity provider from Host.
PORT=3000
DATA_DIR=.data
DESIGNER_TOKENS_JSON={"replace-with-long-random-designer-token":"designer-1"}
# Map verified OIDC subject IDs (profile.sub from userinfo) to House of Briar designer IDs.
DESIGNER_IDENTITY_MAP_JSON={"replace-with-oidc-subject":"designer-1"}
ADMIN_TOKEN=replace-with-a-different-long-random-admin-token-at-least-32-chars
# Prefer labeled operator tokens in production, e.g. {"ops":"...32+ random chars...","finance":"..."}.
ADMIN_TOKENS_JSON=
REVIEW_REQUIRED=true

# Stripe server secret. Never expose this value to browser code.
STRIPE_SECRET_KEY=sk_test_replace_me
# JSON map of House of Briar designer IDs to Stripe Connect account IDs.
STRIPE_CONNECT_ACCOUNTS_JSON={"designer-1":"acct_replace_me"}
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# EasyPost server key used to verify designer shipment tracking before payout.
EASYPOST_API_KEY=EZAK_replace_me
EASYPOST_WEBHOOK_SECRET=replace_with_long_random_webhook_secret

# Resend transactional email. Verify the sending domain before production.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=House of Briar <orders@replace-with-verified-domain.example>

# Optional seller description, tag and aesthetic suggestions (server-side only).
OPENAI_API_KEY=
HOUSE_LISTING_MODEL=gpt-4.1-mini
HOUSE_SUPPORT_MODEL=gpt-4.1-mini

# Optional cloud photo-to-catalog style matching
HOUSE_VISUAL_SEARCH_MODEL=gpt-4.1-mini

# Additional exact public Host authorities, comma separated; no wildcard hosts.
ALLOWED_HOSTS=

# Set true after configuring strong admin tokens and off-site backup settings.
ADMIN_HARDENING_REQUIRED=false
# These settings describe backup configuration, not proof of a completed backup.
OFFSITE_BACKUP_ENABLED=true
BACKUP_S3_ENDPOINT=https://your-private-s3-compatible-endpoint.example
BACKUP_S3_BUCKET=house-of-briar-backups
BACKUP_S3_ACCESS_KEY_ID=replace-with-bucket-scoped-key
BACKUP_S3_SECRET_ACCESS_KEY=replace-with-bucket-scoped-secret
BACKUP_S3_REGION=auto
BACKUP_RETENTION_DAYS=30
